{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    // Tests run in Node, but page.evaluate/addInitScript callbacks run in the
    // browser, so the DOM lib is needed alongside the node types.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["e2e"]
}
